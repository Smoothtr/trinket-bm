# Local production-like mode. Leave both values unset to keep the current JSON/local-admin workflow.
FIREBASE_AUTH_ENABLED=1
DATA_BACKEND=firestore

# Firebase Web app configuration (safe to expose to the browser).
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=trinket-54786.firebaseapp.com
FIREBASE_PROJECT_ID=trinket-54786
FIREBASE_STORAGE_BUCKET=trinket-54786.firebasestorage.app
FIREBASE_WEB_APP_ID=1:526965479424:web:6f2c47d8f47e423fbae0e5
# Optional. Domain must be allowlisted in Firebase Authentication.

# Keyless Google authentication on Vercel. VERCEL_OIDC_TOKEN is injected by
# Vercel after OIDC is enabled for the project; never set it manually.
GCP_PROJECT_ID=trinket-54786
GCP_PROJECT_NUMBER=526965479424
GCP_SERVICE_ACCOUNT_EMAIL=trinket-vercel@trinket-54786.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Legacy fallback for platforms without OIDC. The Trinket Google Cloud project
# currently blocks service-account key creation, so do not use this on Vercel.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# FIREBASE_ADMIN_ACCESS_TOKEN is supported only for short-lived local maintenance scripts.
# It is deliberately ignored on Vercel and must never be stored in an env file.

# Optional namespace for emulator/staging data.
# FIRESTORE_COLLECTION_PREFIX=staging_

# Required before enabling the public Viettel Post webhook on Vercel.
VTP_WEBHOOK_SECRET=
